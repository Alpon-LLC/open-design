# pnpm config (read at the workspace root). pnpm v10 refuses to deploy a
# workspace package that depends on other workspace packages unless
# inject-workspace-packages is true. This setting is a pnpm config key
# (.npmrc), NOT a pnpm-workspace.yaml key — setting it in pnpm-workspace.yaml
# is ignored. Injection keeps the deployed node_modules in the pnpm (.pnpm)
# layout that the OpenDesign image hardening patches target.
inject-workspace-packages=true
